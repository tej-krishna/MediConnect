# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGO_URI=mongodb://127.0.0.1:27017/mediconnect

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
# The website origin to redirect to after a successful Google sign-in (usually the same as
# CORS_ORIGIN's one value, kept separate since CORS_ORIGIN can be a comma-separated list).
FRONTEND_URL=http://localhost:5173

# Google OAuth ("Continue with Google"). Create an OAuth 2.0 Client ID (type: Web application) in
# Google Cloud Console; add GOOGLE_REDIRECT_URI below to its "Authorized redirect URIs". Leave
# unset to disable Google sign-in (the rest of the app works fine without it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# Custom URL scheme the Flutter app registers for deep-link OAuth callbacks.
MOBILE_OAUTH_SCHEME=mediconnect

# File storage: "local" writes to disk (STORAGE_LOCAL_ROOT/STORAGE_PRIVATE_ROOT) — fine for a
# single long-running instance, not for a serverless platform like Vercel (read-only filesystem
# outside /tmp, which isn't persisted or shared across instances anyway). Use "s3" there, or
# anywhere you need durable, horizontally-scalable storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PRIVATE_ROOT=./storage/private
MAX_UPLOAD_SIZE_MB=5

# Required only when STORAGE_DRIVER=s3. Works with AWS S3 directly, or any S3-compatible provider
# (Cloudflare R2, Backblaze B2, MinIO) via AWS_S3_ENDPOINT + AWS_S3_FORCE_PATH_STYLE=true. The
# bucket should be private — every download still goes through the app's own authorization check,
# never a direct object URL.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
